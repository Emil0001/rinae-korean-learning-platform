# PostgreSQL
DATABASE_URL="postgresql://rinae:rinae_password@localhost:5432/rinae_korean?schema=public"
DIRECT_URL="postgresql://rinae:rinae_password@localhost:5432/rinae_korean?schema=public"

# Admin account created or updated by `npm run db:seed`.
# Use a unique password with at least 12 characters. Never reuse production credentials here.
SEED_ADMIN_NAME="Local Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-long-local-password"

# DANGER: the demo seed deletes existing TOPIK attempts/tests and course content.
# Leave false unless you intentionally want to reset those records.
ALLOW_DESTRUCTIVE_DEMO_SEED="false"

# AI content generation (server-side only)
SVINKA_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_IMAGE_MODEL=""

# Vercel Blob. A Vercel storage integration may instead create a store-specific
# variable ending in `_READ_WRITE_TOKEN`, which this application also accepts.
BLOB_READ_WRITE_TOKEN=""

# Application and session configuration
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_TTL_DAYS="30"
PASSWORD_RESET_TTL_MINUTES="60"

# SMTP for contact messages and password-reset emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Rinae Korean <no-reply@example.com>"
CONTACT_TO_EMAIL=""
